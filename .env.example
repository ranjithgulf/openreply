# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Optional: Zoho Directory single sign-on (OpenID Connect). The "Sign in with
# Zoho" button appears only when all four AUTH_ZOHO_* values are set. Take the
# issuer from <AUTH_ZOHO_SSO_URL>/.well-known/openid-configuration — it is an
# org-specific accounts.zoho.<dc>/oauthapp/... URL, not accounts.zoho.com.
# Register <NEXTAUTH_URL>/api/auth/callback/zoho as the redirect URI.
# AUTH_ZOHO_ID=
# AUTH_ZOHO_SECRET=
# AUTH_ZOHO_ISSUER=https://accounts.zoho.com/oauthapp/<org-id>
# AUTH_ZOHO_SSO_URL=https://directory.zoho.com/p/<org-id>/app/<app-id>/sso
# Who may use Zoho sign-in (required; Zoho sign-in is refused when both are
# empty). Exact addresses and/or exact domains, comma separated.
# ZOHO_ALLOWED_EMAILS=
# ZOHO_ALLOWED_DOMAINS=

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Facebook Login for Business ("API setup with Unified Login" in Meta's dashboard).
# Optional: only for accounts connected through Unified Login. Instagram Login
# above keeps working; choose per connect with /api/instagram/connect?method=facebook
# or make it the default with META_LOGIN_METHOD=facebook.
META_LOGIN_METHOD="instagram"
FACEBOOK_APP_ID="your-facebook-app-id"
META_LOGIN_CONFIG_ID="your-facebook-login-configuration-id"
